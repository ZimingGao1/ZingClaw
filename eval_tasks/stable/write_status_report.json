{
  "version": 1,
  "id": "write_status_report",
  "category": "filesystem",
  "fixture": "basic_workspace",
  "input": "Use write_file to create reports/status.md with the exact line Task status: green. Then tell me what file you created.",
  "tags": ["stable", "filesystem", "writes_workspace"],
  "purpose": "Verify creating a markdown report artifact.",
  "allowed_tools": ["write_file", "read_file", "list_dir"],
  "forbidden_tools": ["exec", "web_fetch", "web_search"],
  "expected_artifacts": [
    {"path": "reports/status.md", "exists": true, "contains": ["Task status: green"]}
  ],
  "verifiers": [
    {"type": "status_completed"},
    {"type": "tool_used", "name": "write_file"},
    {"type": "tool_error_absent"},
    {"type": "file_contains", "path": "reports/status.md", "contains": ["Task status: green"]},
    {"type": "workspace_diff_contains", "path": "reports/status.md", "change": "created"}
  ],
  "timeout_seconds": 120
}
