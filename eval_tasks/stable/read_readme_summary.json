{
  "version": 1,
  "id": "read_readme_summary",
  "category": "filesystem",
  "fixture": "basic_workspace",
  "input": "Use read_file to read README.md. Summarize it in one or two sentences and include the phrase fixture-ready.",
  "tags": ["stable", "filesystem", "read_only"],
  "purpose": "Verify reading and summarizing a markdown file.",
  "allowed_tools": ["read_file", "list_dir", "find_files"],
  "forbidden_tools": ["write_file", "edit_file", "apply_patch", "exec", "web_fetch", "web_search"],
  "expected_artifacts": [
    {"path": "README.md", "exists": true, "contains": ["fixture-ready"]}
  ],
  "verifiers": [
    {"type": "status_completed"},
    {"type": "tool_used", "name": "read_file"},
    {"type": "tool_error_absent"},
    {"type": "file_contains", "path": "README.md", "contains": ["fixture-ready"]},
    {"type": "final_answer_contains", "contains": ["fixture-ready"]}
  ],
  "timeout_seconds": 120
}
